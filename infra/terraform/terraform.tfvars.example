# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
#     cp terraform.tfvars.example terraform.tfvars

environment = "staging"
region      = "us-east-2"

# -- Reaching the database from outside the VPC --------------------------------
#
# The database is private by default, which is why migrations and data loads run
# as Lambda invocations. Uncomment both values only if something outside the VPC
# genuinely has to reach it; they give Postgres a public, TLS-only endpoint
# restricted to the networks you name.
#
# Name the narrowest ranges that work. An allowlist of 0.0.0.0/0 exposes the
# database to the entire internet, protected only by the generated password.
#
# database_publicly_accessible = true
# database_allowed_cidrs       = ["203.0.113.0/24"]

# -- Accounts ------------------------------------------------------------------
#
# Leave these out and accounts stay switched off. docs/source/accounts.md walks
# through creating the Auth0 tenant they come from. The keys are fetched once:
#
#     curl -s https://studyspot.us.auth0.com/.well-known/jwks.json
#
# auth0_domain    = "studyspot.us.auth0.com"
# auth0_client_id = "..."
# auth0_audience  = "https://api.studyspot.app"
# auth0_jwks      = <<-EOT
#   {"keys":[...]}
# EOT

# -- Production hardening ------------------------------------------------------
#
# environment              = "production"
# db_deletion_protection   = true
# db_skip_final_snapshot   = false
# db_multi_az              = true
# db_backup_retention_days = 14
# site_bucket_force_destroy = false
